# VLM Provider configuration: 'ollama' (default/local), 'gemini' (cloud), or 'heuristic' (offline)
VLM_PROVIDER=ollama

# Ollama local settings (when VLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
VLM_MODEL=qwen2.5vl:7b
# Abort one Ollama call after this long and answer with the heuristic planner
# instead. Must stay under the client's 60s escalation timeout, or the client
# gives up before the fallback is delivered. Cold-loading a 7B vision model can
# exceed this on the first request.
OLLAMA_TIMEOUT_MS=25000

# Gemini Cloud settings (when VLM_PROVIDER=gemini)
# GOOGLE_API_KEY=your_key_here
# VLM_MODEL=gemini-2.5-pro

PORT=8080
HOST=127.0.0.1
LATENCY_BUDGET_MS=15000
MAX_REQUESTS_PER_MIN=60

